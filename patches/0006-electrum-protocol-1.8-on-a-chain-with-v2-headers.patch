+// ---------------------------------------------------------------------------
+// Electrum protocol 1.8
+// ---------------------------------------------------------------------------
+//
+// Everything this fork changes about the Electrum protocol lives here, so that
+// replacing it with whatever upstream settles on is a matter of deleting this
+// section and the handful of call sites that name it, rather than unpicking
+// edits spread through `electrum.rs`.
+//
+// The proposal is `docs/electrum-header-v2.md` in the pruned-electrs repo. Only
+// the parts that apply to this server are implemented:
+//
+//   1. Protocol version 1.8.
+//   2. A server on a chain with v2 headers refuses to negotiate below it.
+//   3. Header length is read, not assumed. Already true here: `block.header`
+//      and `block.headers` serialize whatever the header is, so both the
+//      concatenated and per-header forms carry the real length. Nothing to do.
+//   4. Checkpoint proofs (`cp_height`) use the chain's own block hash. Not
+//      implemented, because electrs 0.11.1 does not implement `cp_height` at
+//      all and clients tolerate its absence. If it is ever added, the leaves at
+//      or above the activation height must be BLAKE2b, and `AnyHeader::block_hash`
+//      already returns exactly that.
+//   5. Chain identity beyond `genesis_hash`, which cannot distinguish this
+//      chain from ordinary testnet4: they share a genesis block.
+
+/// The version this server negotiates on a chain whose headers are v2.
+pub const PROTOCOL_VERSION_V2: &str = "1.8";
+
+/// The version negotiated on every other chain, unchanged from upstream.
+pub const PROTOCOL_VERSION_V1: &str = "1.4";
+
+/// Which version a chain should negotiate.
+///
+/// Keyed on whether the chain has actually produced a v2 header rather than on
+/// the network name, so a chain that has not reached its activation height
+/// still speaks 1.4 and every existing client keeps working. It flips the first
+/// time a v2 header is indexed.
+///
+/// The safety-critical half is the refusal, not the number. A client below 1.8
+/// does not fail loudly on a v2 chain: it reads 80 bytes of a 164-byte header,
+/// gets a structurally plausible header, computes SHA256d over it, and cannot
+/// link the chain. Depending on the client that surfaces as a sync problem
+/// rather than an incompatibility. A closed connection is far better than a
+/// wallet that quietly believes something false.
+pub fn protocol_version(chain_has_v2: bool) -> &'static str {
+    if chain_has_v2 {
+        PROTOCOL_VERSION_V2
+    } else {
+        PROTOCOL_VERSION_V1
+    }
+}
+
+/// Where this chain's headers changed format, for `server.features`.
+///
+/// `genesis_hash` cannot answer "which chain is this" on a proof-of-work fork
+/// that keeps its history: this chain and ordinary testnet4 share a genesis
+/// block and diverge only at the activation height. Two servers can report the
+/// same genesis and serve chains that disagree from 149537 onward.
+///
+/// Reported as a fork point rather than an opaque chain id because it needs no
+/// registry and a client can verify it against what the server then serves: ask
+/// for that height's header and check it is v2 and hashes to the stated hash.
+///
+/// Returns `None` on a chain with no v2 header, which is the honest answer for
+/// every chain that has not forked.
+///
+/// Found by binary search over the header chain rather than a compiled-in
+/// height, because the format switch is monotone: once v2, always v2. That
+/// keeps this correct on regtest, where the height is whatever the operator set
+/// with `-testactivationheight`, without the server having to be told.
+pub fn fork_point(chain: &crate::chain::Chain) -> Option<serde_json::Value> {
+    if !chain.has_v2_headers() {
+        return None;
+    }
+    let (mut lo, mut hi) = (0usize, chain.height());
+    while lo < hi {
+        let mid = lo + (hi - lo) / 2;
+        match chain.get_block_header(mid) {
+            Some(h) if h.is_v2() => hi = mid,
+            _ => lo = mid + 1,
+        }
+    }
+    let header = chain.get_block_header(lo)?;
+    Some(serde_json::json!({
+        "height": lo,
+        "hash": header.block_hash().to_string(),
+        "header_bytes": HEADER_V2_SIZE,
+        "block_hash": "blake2b",
+    }))
+}
+
+#[cfg(test)]
+mod protocol_tests {
+    use super::*;
+
+    /// The negotiation rule, which is the safety-critical half of the proposal.
+    #[test]
+    fn negotiates_18_only_on_a_v2_chain() {
+        assert_eq!(protocol_version(false), "1.4");
+        assert_eq!(protocol_version(true), "1.8");
+    }
+
+    /// A chain that has not reached its activation height must keep speaking
+    /// 1.4, or every existing client breaks on a chain they can read perfectly
+    /// well. The switch is the appearance of a v2 header, not the network name.
+    #[test]
+    fn a_pre_activation_chain_is_unchanged() {
+        assert_eq!(protocol_version(false), PROTOCOL_VERSION_V1);
+    }
+}

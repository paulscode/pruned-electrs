+    /// Has this chain produced a v2 header?
+    ///
+    /// The tip is enough: the header format is a one-way switch at the
+    /// activation height, so a v2 tip means the chain has crossed it and every
+    /// header from here on is v2. Cheaper than scanning, and it flips at
+    /// exactly the right moment.
+    ///
+    /// Used to decide the Electrum protocol version to negotiate; see
+    /// `headerv2::protocol_version`.
+    pub(crate) fn has_v2_headers(&self) -> bool {
+        self.headers
+            .last()
+            .map(|(_hash, header)| header.is_v2())
+            .unwrap_or(false)
+    }

+/// Scans the `headers` column family, yielding rows of any legal header size.
+///
+/// Deliberately not a `DBIterator<N>`: header rows stopped being fixed width
+/// when v2 arrived. Anything that is not one of the two header sizes is skipped,
+/// which is how `TIP_KEY` (one byte, same column family) stays out of the
+/// results without this needing to know its name.
+struct HeaderIterator<'a> {
+    raw: rocksdb::DBRawIterator<'a>,
+    done: bool,
+}
+
+impl Iterator for HeaderIterator<'_> {
+    type Item = SerializedHeaderRow;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        while !self.done {
+            let key = match self.raw.key() {
+                Some(key) => key,
+                None => {
+                    self.raw.status().expect("DB scan failed");
+                    break; // end of scan
+                }
+            };
+            let row = match key.len() {
+                HEADER_V1_SIZE | HEADER_V2_SIZE => Some(key.to_vec()),
+                _ => None, // TIP_KEY, or anything else that is not a header
+            };
+            self.raw.next();
+            if let Some(row) = row {
+                return Some(row);
+            }
+        }
+        self.done = true;
+        None
+    }
+}

+/// Walk a serialized block's transactions, feeding a `bitcoin_slices` visitor.
+///
+/// A drop-in replacement for `bsl::Block::visit` for the one thing electrs uses
+/// it for. `bsl::Block::visit` cannot be used on a v2 chain: it parses exactly
+/// 80 bytes of header and then reads the transaction-count varint from offset
+/// 80, so on a 164-byte header it would take 84 bytes of header as the count and
+/// every transaction after it would be garbage. It is not a parse error, which
+/// is what makes it dangerous: it silently indexes nonsense.
+///
+/// Rather than fork `bitcoin_slices`, this reimplements the eight lines of
+/// `Block::visit` that matter, using its public `scan_len` and `Transaction`.
+/// The transaction parsing, which is all of the cost, is unchanged and still
+/// theirs. `header` is passed in rather than re-parsed because the caller
+/// already needs it.
+///
+/// The visitor's `visit_block_header` hook is deliberately *not* called: it
+/// takes a `bsl::BlockHeader`, which cannot represent a v2 header, so a visitor
+/// relying on it would silently see nothing. Callers take the header from the
+/// `header` argument instead.
+pub fn visit_block_txs<V: bitcoin_slices::Visitor>(
+    block: &[u8],
+    header: &AnyHeader,
+    visitor: &mut V,
+) -> Result<()> {
+    use bitcoin_slices::{bsl, Visit};
+
+    let mut consumed = header.size();
+    ensure!(
+        block.len() > consumed,
+        "block is {} bytes, shorter than its own {}-byte header plus a transaction count",
+        block.len(),
+        consumed
+    );
+
+    let total_txs = bsl::scan_len(&block[consumed..], &mut consumed)
+        .map_err(|e| anyhow!("bad transaction count: {:?}", e))? as usize;
+
+    visitor.visit_block_begin(total_txs);
+    for i in 0..total_txs {
+        let tx = bsl::Transaction::visit(&block[consumed..], visitor)
+            .map_err(|e| anyhow!("bad transaction at index {}: {:?}", i, e))?;
+        consumed += tx.consumed();
+    }
+    Ok(())
+}

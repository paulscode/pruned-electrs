diff --git a/internal/config_specification.toml b/internal/config_specification.toml
index f4ae65e..4418723 100644
--- a/internal/config_specification.toml
+++ b/internal/config_specification.toml
@@ -81,6 +81,16 @@ name = "daemon_p2p_addr"
 type = "crate::config::ResolvAddr"
 doc = "Bitcoin daemon p2p 'addr:port' to connect (default: 127.0.0.1:8333 for mainnet, 127.0.0.1:18333 for testnet, 127.0.0.1:18444 for regtest and 127.0.0.1:38333 for signet)"
 
+[[param]]
+name = "helper_rpc_addr"
+type = "crate::config::ResolvAddr"
+doc = "Optional archival node to read pruned blocks from, as 'addr:port'. Both chains of a fork share every block below the split, so a second full node on this machine already holds most of what a pruned node has discarded, and reading them over a local RPC is far cheaper than fetching them from the network. Only consulted for blocks the pruned node no longer has; a block this node cannot supply falls back to the usual path. Ignored unless helper_cookie_file is also set."
+
+[[param]]
+name = "helper_cookie_file"
+type = "std::path::PathBuf"
+doc = "Cookie file authenticating to helper_rpc_addr. Ignored unless helper_rpc_addr is also set."
+
 [[param]]
 name = "monitoring_addr"
 type = "crate::config::ResolvAddr"

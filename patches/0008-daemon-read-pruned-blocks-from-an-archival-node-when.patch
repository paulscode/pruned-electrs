+    /// A pruned block read from the archival helper, or `None` to use the usual source.
+    ///
+    /// Never an error: the helper is an optimisation, so every way it can fail resolves to falling
+    /// back rather than to stopping. The caller cannot tell the difference except in speed.
+    ///
+    /// The returned bytes are checked against the hash that was asked for. Fetching by hash is
+    /// already self-limiting — a block on the other side of the split has a hash this node has
+    /// never seen, so it cannot be served by mistake — but nothing else in the pipeline verifies
+    /// what a block source returns, and this is the one source that is a different node following a
+    /// different chain. Checking here costs one header parse and removes the whole question.
+    fn block_from_helper(&self, hash: BlockHash, height: usize) -> Option<SerBlock> {
+        let helper = self.helper.as_ref()?;
+        if height >= self.helper_ceiling.load(Ordering::Relaxed) {
+            return None;
+        }
+
+        match get_block_raw_with(helper, hash) {
+            Ok(block) => match AnyHeader::parse(&block) {
+                // The expected case: shared history, byte-identical on both chains.
+                Ok(header) if header.block_hash() == hash => Some(block),
+                // Bytes that are not the block that was asked for. Not a boundary and not
+                // transient, so the helper is wrong about something and is dropped for this block
+                // loudly rather than quietly.
+                Ok(header) => {
+                    warn!(
+                        "the archival helper returned {} for block {}; using the usual source instead",
+                        header.block_hash(),
+                        hash
+                    );
+                    None
+                }
+                Err(e) => {
+                    warn!("the archival helper returned an unparseable block for {}: {:#}", hash, e);
+                    None
+                }
+            },
+            Err(e) => {
+                // `Block not found` is the boundary: the helper's chain diverged below this height,
+                // so nothing above it will be there either. Recording it turns a per-block failure
+                // into one failure for the rest of the run.
+                //
+                // Every other error is transient by assumption — the helper restarting, a timeout —
+                // and must not fix the ceiling, or a moment's unavailability would disable the
+                // helper for the whole index build.
+                if is_block_not_found(&e) {
+                    let prev = self.helper_ceiling.swap(height, Ordering::Relaxed);
+                    if prev == usize::MAX {
+                        info!(
+                            "the archival helper does not have block {} at height {}; using it only below that height from now on",
+                            hash, height
+                        );
+                    }
+                } else {
+                    debug!("the archival helper failed for block {}: {:#}", hash, e);
+                }
+                None
+            }
+        }
+    }
+
     /// Lowest height bitcoind still stores block data for. Re-read per batch
     /// rather than cached: it advances as bitcoind prunes, and reading a stale
     /// value low would route a since-pruned block to p2p and hang.

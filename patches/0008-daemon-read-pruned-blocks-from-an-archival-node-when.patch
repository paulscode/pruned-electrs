 }
 
+/// `getblock <hash> 0` against a given client, so the helper can be asked with the same call.
+fn get_block_raw_with(client: &Client, hash: BlockHash) -> Result<SerBlock> {
+    let hex: String = client
+        .call("getblock", &[json!(hash), json!(0)])
+        .context("getblock failed")?;
+    Vec::from_hex(&hex).context("bitcoind returned a non-hex block")
+}
+
+/// Is this the RPC error bitcoind gives for a block it has never heard of?
+///
+/// Distinguished from every other failure because it is the only one that also means "and never
+/// will be": it marks where the helper's chain and this one diverged. Matched on the message rather
+/// than the code because the error arrives here already wrapped by `anyhow`.
+fn is_block_not_found(err: &anyhow::Error) -> bool {
+    format!("{:#}", err).contains("Block not found")
+}
+
+/// Connect to the archival helper, which is a different node with a different cookie.
+///
+/// Deliberately not `rpc_connect`: that one reads the address and auth of the node being indexed,
+/// and the helper is by definition somewhere else. Only the timeout is shared.
+fn connect_helper(addr: SocketAddr, cookie: &Path, config: &Config) -> Result<Client> {
+    let (user, pass) = read_cookie(cookie)?;
+    let builder = jsonrpc::simple_http::SimpleHttpTransport::builder()
+        .url(&format!("http://{}", addr))?
+        .timeout(config.jsonrpc_timeout)
+        .auth(user, Some(pass));
+    Ok(Client::from_jsonrpc(jsonrpc::Client::with_transport(
+        builder.build(),
+    )))
+}
+
 fn rpc_connect(config: &Config) -> Result<Client> {
     let rpc_url = format!("http://{}", config.daemon_rpc_addr);
     // Allow RPC calls to take longer before timing out.

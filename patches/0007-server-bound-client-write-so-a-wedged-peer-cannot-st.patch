From ec71988ee19e9b73132dd7a6f8aaadc9936b6ef7 Mon Sep 17 00:00:00 2001
From: Paul Lamb <paul@paulscode.com>
Date: Mon, 31 Aug 2026 09:37:48 -0500
Subject: [PATCH 7/7] server: bound client write so a wedged peer cannot stall
 the server

Carried into this tree from the package's patch set, which had it while
this tree did not. The two sets had drifted in both directions: this fix
existed only in the package, while protocol 1.8 and the concurrent pruned
fetch existed only here, so neither was a superset and regenerating either
from the other would have silently dropped work.

This tree is now the single source; the package's patches are generated
from these commits rather than maintained alongside them.
---
 src/server.rs | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/src/server.rs b/src/server.rs
index b5b0cb9..770dfbf 100644
--- a/src/server.rs
+++ b/src/server.rs
@@ -7,6 +7,7 @@ use std::{
     io::{BufRead, BufReader, Write},
     iter::once,
     net::{Shutdown, TcpListener, TcpStream},
+    time::Duration,
 };
 
 use crate::{
@@ -17,6 +18,18 @@ use crate::{
     thread::spawn,
 };
 
+/// How long a single write to a client may make no progress before that client
+/// is dropped.
+///
+/// This is `SO_SNDTIMEO`, so it bounds one `write` syscall, not a whole
+/// response: a client that keeps draining resets it on every partial write, so
+/// a slow link cannot trip it however large the response. What trips it is a
+/// receive window that stays shut for the whole minute — a peer that is gone,
+/// or one whose application has stopped reading altogether. A live-but-stalled
+/// client can manage that and will be disconnected; it reconnects, which is the
+/// ordinary cost of not letting it freeze the server for everyone else.
+const WRITE_TIMEOUT: Duration = Duration::from_secs(60);
+
 struct Peer {
     id: usize,
     client: Client,
@@ -216,6 +229,19 @@ fn handle_peer_events(
 fn accept_loop(listener: TcpListener, server_tx: Sender<Event>) -> Result<()> {
     for (peer_id, conn) in listener.incoming().enumerate() {
         let stream = conn.context("failed to accept")?;
+        // Responses are written from `handle_events`, which runs inline on the
+        // single server loop alongside `rpc.sync()`. `Peer::send` uses a
+        // blocking `write_all`, so a client that stops draining its receive
+        // window — gone without a FIN, suspended, or behind a stalled proxy —
+        // holds that loop for as long as the kernel keeps retrying, freezing
+        // indexing and every other client with it. Bound the wait so the
+        // existing error path can drop just the offending peer instead.
+        //
+        // `try_clone` below dups the fd, and the option lives on the socket, so
+        // setting it here also covers the clone handed to `Peer`.
+        if let Err(e) = stream.set_write_timeout(Some(WRITE_TIMEOUT)) {
+            warn!("{}: failed to set write timeout {}", peer_id, e);
+        }
         let tx = server_tx.clone();
         spawn("recv_loop", move || {
             let result = recv_loop(peer_id, &stream, tx);
